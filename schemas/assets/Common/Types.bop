struct Color
{
    uint32 a;
    uint32 r;
    uint32 g;
    uint32 b;
}

struct Vector2f
{
    float32 x;
    float32 y;
}

struct Vector2i
{
    int32 x;
    int32 y;
}

struct Vector2u
{
    uint32 x;
    uint32 y;
}

struct IntRect
{
    int32 x;
    int32 y;
    int32 width;
    int32 height;
}

struct FloatRect
{
    float32 x;
    float32 y;
    float32 width;
    float32 height;
}

struct Transform
{
    Vector2f position;
    Vector2f scale;
    float32  rotation;
    Vector2f origin;
}
