message SetInfoItem
{
    1 -> string Type;
    2 -> SetInfoItemDependency Require;
    3 -> SetInfoMetadata Attributes;
}

message SetInfoItemDependency
{
    1 -> uint32[] Items;
}

message SetInfoAttributes
{
    1 -> string Version;
}

message SetInfoDependency
{
    1 -> map[uint32, SetInfoItem] Sets;
}

message SetInfoData
{
    1 -> SetInfoDependency Require;
    2 -> SetInfoAttributes Attributes;
}